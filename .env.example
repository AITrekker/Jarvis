# Copy to .env and fill in. .env is gitignored.

# Postgres connection string. Local dev default matches `make db.up`.
JARVIS_DB_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis

# Hugging Face token, required by pyannote to download diarization models.
HF_TOKEN=

# Optional: override the config.toml location.
# JARVIS_CONFIG=/path/to/config.toml
