# Project data — never commit recordings or local DB state
data/
audio/
*.wav
*.mp3
*.flac
*.m4a
*.log
logs/

# Allow committed test fixtures only
!tests/fixtures/**/*.wav
!tests/fixtures/**/*.mp3

# Migration artifacts you don't want to commit
*.sql.bak
